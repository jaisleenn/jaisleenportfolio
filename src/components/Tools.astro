---
type Skill = { name: string; tooltip?: string };

const platforms: Skill[] = [
  {
    name: "LinkedIn Campaign Manager",
    tooltip: "Tested lead-gen forms across financial-services campaigns at Cohesity",
  },
  {
    name: "LinkedIn Sales Navigator",
    tooltip: "Sourced 350+ qualified B2B leads for Tesla",
  },
  { name: "HubSpot" },
  { name: "Sprout Social" },
  {
    name: "Semrush",
    tooltip: "Benchmarked Tesla's blog against Lucid and Rivian",
  },
  { name: "Google Analytics" },
  {
    name: "Microsoft Copilot",
    tooltip: "Built a reporting automation that cut a 45-min weekly task",
  },
  { name: "Claude" },
  { name: "ChatGPT" },
  { name: "Canva" },
  { name: "Excel" },
  { name: "Google Workspace" },
  { name: "Jira" },
];

const marketing: Skill[] = [
  { name: "Campaign Planning & Execution" },
  { name: "A/B Testing" },
  { name: "Marketing Funnel & Lifecycle Analysis" },
  { name: "Competitive Research" },
  { name: "Performance Dashboards & Reporting" },
];

const professional: Skill[] = [{ name: "Cross-Functional Collaboration" }];

const groups: { label: string; items: Skill[] }[] = [
  { label: "Platforms & Tools", items: platforms },
  { label: "Marketing Skills", items: marketing },
  { label: "Professional", items: professional },
];

const skillClass = "text-sm text-white";
---

<section class="border-t border-neutral/15 pt-20 pb-10 md:pt-24 md:pb-12">
  <h2 class="mb-14 font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl">
    Tools & Skills
  </h2>

  <div class="flex flex-col gap-12">
    {
      groups.map((group) => (
        <div>
          <h3 class="mb-3 text-sm font-medium tracking-wide text-primary">
            {group.label}
          </h3>
          <div class="flex flex-wrap gap-x-5 gap-y-2">
            {group.items.map((item) =>
              item.tooltip ? (
                <span class="skill-tip relative inline-flex" data-skill-tooltip>
                  <span
                    class={`${skillClass} cursor-default underline decoration-neutral/30 decoration-dotted underline-offset-4`}
                    tabindex="0"
                    aria-describedby={`tip-${item.name.replace(/\s+/g, "-").toLowerCase()}`}
                  >
                    {item.name}
                  </span>
                  <span
                    id={`tip-${item.name.replace(/\s+/g, "-").toLowerCase()}`}
                    role="tooltip"
                    data-skill-tip
                    class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 w-max max-w-64 py-2 text-center text-xs leading-snug text-neutral opacity-0 transition-opacity duration-200 ease-out"
                  >
                    {item.tooltip}
                  </span>
                </span>
              ) : (
                <span class={skillClass}>{item.name}</span>
              ),
            )}
          </div>
        </div>
      ))
    }
  </div>

  <p class="mt-10 text-neutral italic">Site built with Cursor and deployed on Vercel.</p>
</section>

<script>
  const showTip = (wrap: Element) => {
    const tip = wrap.querySelector("[data-skill-tip]");
    if (!(tip instanceof HTMLElement)) return;
    tip.style.opacity = "1";
    tip.style.transform = "translateX(-50%)";
    const rect = tip.getBoundingClientRect();
    const pad = 12;
    let dx = 0;
    if (rect.left < pad) dx = pad - rect.left;
    if (rect.right > window.innerWidth - pad) {
      dx = window.innerWidth - pad - rect.right;
    }
    tip.style.transform = `translateX(calc(-50% + ${dx}px))`;
  };

  const hideTip = (wrap: Element) => {
    const tip = wrap.querySelector("[data-skill-tip]");
    if (!(tip instanceof HTMLElement)) return;
    tip.style.opacity = "0";
  };

  document.querySelectorAll("[data-skill-tooltip]").forEach((wrap) => {
    wrap.addEventListener("mouseenter", () => showTip(wrap));
    wrap.addEventListener("mouseleave", () => hideTip(wrap));
    wrap.addEventListener("focusin", () => showTip(wrap));
    wrap.addEventListener("focusout", () => hideTip(wrap));
  });
</script>
