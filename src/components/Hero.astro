---
import { Image } from "astro:assets";
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, summary, email } = Astro.props;
---

<section class="pt-4 pb-12 md:pb-16" id="#hero">
  <div class="relative left-1/2 w-[min(72rem,calc(100vw-2.5rem))] -translate-x-1/2">
    <div class="flex flex-row items-start gap-4 md:gap-10">
      <div class="relative aspect-[3/4] w-28 shrink-0 overflow-hidden rounded-xl sm:w-40 md:w-64 lg:w-72">
        <Image
          class="absolute inset-0 h-full w-full object-cover object-top"
          src="/jaisleen-headshot.jpg"
          alt="Jaisleen Nijjar"
          width="682"
          height="755"
        />
      </div>
      <div class="min-w-0 flex-1">
        <h1 class="type-hero mb-4">
          {name}
        </h1>
        <p class="type-body mb-8 whitespace-pre-line text-ink">
          {summary}
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            class="type-body inline-block rounded-full bg-primary px-6 py-3 text-[#fff]"
            href={`mailto:${email}`}>Get in Touch</a
          >
          <a
            class="type-body inline-block rounded-full bg-primary px-6 py-3 text-[#fff]"
            href="https://linkedin.com/in/jaisleen-nijjar/"
            target="_blank"
            rel="noopener noreferrer">LinkedIn</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
