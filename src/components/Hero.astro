---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, summary, email } = Astro.props;
---

<section class="pt-8 pb-16" id="#hero">
  <h1
    class="mb-8 font-serif text-4xl font-bold tracking-tightest text-white sm:text-5xl md:text-6xl"
  >
    {name}
  </h1>
  <p class="mb-16 whitespace-pre-line text-base font-normal text-neutral md:text-lg">
    {summary}
  </p>

  <div class="flex flex-wrap gap-4">
    <a
      class="inline-block rounded-full bg-primary px-8 py-5 text-sm leading-5 font-medium text-[#fff]"
      href={`mailto:${email}`}>Get in Touch</a
    >
    <a
      class="inline-block rounded-full bg-primary px-8 py-5 text-sm leading-5 font-medium text-[#fff]"
      href="https://linkedin.com/in/jaisleen-nijjar/"
      target="_blank"
      rel="noopener noreferrer">LinkedIn</a
    >
  </div>
</section>
