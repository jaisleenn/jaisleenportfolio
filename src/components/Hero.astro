---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, summary, email } = Astro.props;
---

<section class="pt-4 pb-12 md:pb-16" id="#hero">
  <h1
    class="mb-4 font-serif text-3xl font-bold tracking-tightest text-white sm:text-4xl md:text-5xl"
  >
    {name}
  </h1>
  <p class="mb-8 whitespace-pre-line text-sm font-normal leading-relaxed text-neutral md:text-base">
    {summary}
  </p>

  <div class="flex flex-wrap gap-3">
    <a
      class="inline-block rounded-full bg-primary px-6 py-3 text-sm leading-5 font-medium text-[#fff]"
      href={`mailto:${email}`}>Get in Touch</a
    >
    <a
      class="inline-block rounded-full bg-primary px-6 py-3 text-sm leading-5 font-medium text-[#fff]"
      href="https://linkedin.com/in/jaisleen-nijjar/"
      target="_blank"
      rel="noopener noreferrer">LinkedIn</a
    >
  </div>
</section>
