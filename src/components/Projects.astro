---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  {
    projects.map(({ name, summary, image, linkPreview, linkSource, campaignId, isNdaRestricted }, index) => {
      const top = 98 + index * 40;
      const isInternalLink = linkPreview?.startsWith('#');
      return (
        <div
          style={`top: ${top}px;`}
          class="sticky mb-8 overflow-hidden rounded-2xl border border-neutral/20 bg-black"
        >
          <div class="relative z-[1] grid h-[17.5rem] w-full grid-rows-2 rounded-2xl bg-black sm:grid-cols-2 sm:grid-rows-1 sm:h-[15.5rem]">
            <div class="flex min-h-0 flex-col justify-center overflow-hidden px-5 py-5 sm:px-6">
              <h3 class="mb-2 font-serif text-xl font-medium text-primary md:text-2xl">
                {name}
              </h3>
              <p class="text-sm leading-snug text-white md:text-base">{summary}</p>
              <div class="flex gap-5 pt-4 text-sm text-primary">
                {isNdaRestricted ? (
                  <span class="text-neutral italic">NDA-restricted work</span>
                ) : (
                  <a
                    href={linkPreview}
                    target={isInternalLink ? undefined : "_blank"}
                    class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline"
                  >
                    {campaignId ? "View Campaign" : "Preview"}
                  </a>
                )}
              </div>
            </div>
            <div class="min-h-0 overflow-hidden">
              <Image
                class="h-full w-full rounded-ss-xl rounded-ee-2xl object-cover object-center"
                src={image}
                alt={name}
                width="736"
                height="483"
              />
            </div>
          </div>
        </div>
      );
    })
  }
</Section>
