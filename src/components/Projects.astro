---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  {
    projects.map(({ name, summary, image, linkPreview, linkSource, campaignId, isNdaRestricted }, index) => {
      const top = 98 + index * 40;
      const isInternalLink = linkPreview?.startsWith('#');
      return (
        <div
          style={`top: ${top}px;`}
          class="sticky mb-8 rounded-2xl border border-neutral/20 bg-black"
        >
          <div class="relative z-[1] grid w-full grid-rows-[auto_auto] rounded-2xl bg-black sm:grid-cols-2 sm:grid-rows-1 sm:items-stretch">
            <div class="flex flex-col justify-center px-6 py-6">
              <h3 class="mb-3 font-serif text-2xl font-medium text-primary md:text-3xl">
                {name}
              </h3>
              <p class="text-sm text-white md:text-base">{summary}</p>
              <div class="flex gap-5 pt-5 text-primary">
                {isNdaRestricted ? (
                  <span class="text-neutral italic">NDA-restricted work</span>
                ) : (
                  <a
                    href={linkPreview}
                    target={isInternalLink ? undefined : "_blank"}
                    class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline"
                  >
                    {campaignId ? "View Campaign" : "Preview"}
                  </a>
                )}
              </div>
            </div>
            <div class="flex min-h-36 items-end overflow-hidden sm:min-h-0">
              <Image
                class="h-36 w-full rounded-ss-xl rounded-ee-2xl object-cover object-center sm:h-full sm:min-h-[11.5rem] sm:w-full"
                src={image}
                alt={name}
                width="736"
                height="483"
              />
            </div>
          </div>
        </div>
      );
    })
  }
</Section>
