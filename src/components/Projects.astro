---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  <div class="relative left-1/2 w-[min(72rem,calc(100vw-2.5rem))] -translate-x-1/2">
    <div class="grid grid-cols-1 gap-16 md:grid-cols-3 md:gap-10">
      {
        projects.map(({ name, summary, image, linkPreview, campaignId, isNdaRestricted }) => {
          const isInternalLink = linkPreview?.startsWith("#");
          return (
            <div class="flex min-h-0 flex-col">
              <div class="relative aspect-[4/3] w-full overflow-hidden rounded-xl">
                <Image
                  class="absolute inset-0 h-full w-full object-cover object-center"
                  src={image}
                  alt={name}
                  width="736"
                  height="483"
                />
              </div>
              <div class="flex flex-1 flex-col pt-5">
                <h3 class="mb-2 font-serif text-xl font-medium text-primary md:text-2xl">
                  {name}
                </h3>
                <p class="flex-1 text-sm leading-snug text-white">{summary}</p>
                <div class="pt-4 text-sm text-primary">
                  {isNdaRestricted ? (
                    <span class="text-neutral italic">NDA-restricted work</span>
                  ) : (
                    <a
                      href={linkPreview}
                      target={isInternalLink ? undefined : "_blank"}
                      class="after:relative after:bottom-[-5px] after:content-[url(/external.svg)] hover:underline"
                    >
                      {campaignId ? "View Campaign" : "Preview"}
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</Section>
