---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { socialLinks } = Astro.props;
---

<footer class="page-wrap border-t border-neutral/15 pt-10 pb-8 text-white">
  <ul class="type-body flex flex-wrap gap-x-5">
    {
      socialLinks.map(({ text, href }) => (
        <li>
          <a
            href={href}
            target="_blank"
            class="inline-block py-3 text-white after:relative after:bottom-[-4px] after:content-[url(/external.svg)] hover:text-primary"
          >
            {text}
          </a>
        </li>
      ))
    }
  </ul>
</footer>
