---

<Layout pageTitle="Cohesity Intern Visibility Campaign — Jaisleen Nijjar">
  <article class="pt-8 pb-16 sm:pt-4 md:pb-24">
    <a href="/#projects" class="type-body mb-8 inline-block text-primary hover:underline">
      ← Featured Projects
    </a>

    <h1 class="type-hero mb-10 md:mb-14">Cohesity Intern Visibility Campaign</h1>

    <div class="grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-6">
      {
        featured.map((piece) => (
          <section class="grid min-w-0 grid-cols-[7.5rem_minmax(0,1fr)] items-start gap-x-4 gap-y-2 sm:flex sm:flex-col sm:gap-0">
            <h2 class="type-heading col-span-2 sm:mb-3">{piece.title}</h2>
            <p class="type-body col-start-2 row-start-2 text-ink sm:mb-4">{piece.caption}</p>
            <a
              href={piece.linkedInUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="col-start-1 row-start-2 block sm:mt-auto"
            >
              <div class="aspect-[4/5] overflow-hidden rounded-xl">
                <img
                  src={piece.image}
                  alt={piece.title}
                  class="h-full w-full object-cover object-top"
                />
              </div>
            </a>
          </section>
        ))
      }
    </div>

    <section class="mt-20 border-t border-neutral/15 pt-16">
      <h2 class="type-heading mb-10">More from the campaign</h2>

      <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
        {
          moreFromCampaign.map((post) => (
            <a href={post.linkedInUrl} target="_blank" rel="noopener noreferrer" class="flex min-w-0 flex-col">
              <div class="aspect-[4/5] overflow-hidden rounded-xl">
                <img
                  src={post.image}
                  alt={post.title}
                  class:list={["h-full w-full object-cover", post.imagePosition ?? "object-top"]}
                />
              </div>
              <span class="type-body mt-3 text-ink">{post.title}</span>
            </a>
          ))
        }
      </div>
    </section>
  </article>
</Layout>
