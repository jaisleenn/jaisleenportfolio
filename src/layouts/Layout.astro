---
import Header from "@components/Header.astro";
import "@fontsource/forum";
import { SITE_CONFIG } from "@config";
import "../styles/global.css";

const {
  description,
  siteLogo,
  navLinks,
  lang,
  author,
} = SITE_CONFIG;

interface Props {
  pageTitle?: string;
}

// Use Astro.site from astro.config.mjs for absolute URLs
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://jaisleen.com";
const currentPageUrl = new URL(Astro.url.pathname, `${siteUrl}/`).href;
const shareTitle = currentPageUrl.replace(/^https:\/\//, "").replace(/\/$/, "");
---

<!doctype html>
<html lang={lang} class="scroll-pt-16 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/jaisleen-small.png" />
    <link href="https://fonts.cdnfonts.com/css/glacial-indifference-2" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <title>{shareTitle}</title>

    <!-- Shares show the URL, not the page title -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:url" content={currentPageUrl} />
  </head>
  <body class="type-body bg-black text-white">
    <Header siteLogo={siteLogo} navLinks={navLinks} />
    <main class="mx-auto max-w-3xl px-[var(--page-pad)]">
      <slot />
    </main>
  </body>
</html>
